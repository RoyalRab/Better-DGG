{
  "name": "DGG Remix",
  "short_name": "DGG Remix",
  "description": "Unofficial fan-made app for watching destiny.gg streams and live embeds with chat. Keeps your screen on, and Kick streams keep playing when your phone locks.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#11151d",
  "theme_color": "#11151d",
  "icons": [
    {
      "src": "icons/icon-192.png?v=5",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png?v=5",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png?v=5",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Destiny's stream",
      "short_name": "Destiny",
      "url": "./#kick/destiny",
      "icons": [
        {
          "src": "icons/icon-192.png?v=5",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Multi-view",
      "short_name": "Multi-view",
      "url": "./?restore=1",
      "icons": [
        {
          "src": "icons/icon-192.png?v=5",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
